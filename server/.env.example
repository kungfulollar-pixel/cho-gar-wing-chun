# Copy to .env and fill in. Load it with: node --env-file=.env server.js
# .env is git-ignored — never commit real credentials.
#
# Nothing here is required. Every value has a working default in the code
# (see server/DEPLOY.md), so the app runs on the live host with SMTP_PASS alone.
# This file exists to document what can be overridden.

# ---------- the only variable the live site needs ----------
# Password of the mailbox in SMTP_USER. Without it no mail is sent — messages
# are written to the log instead, and the server says so at startup.
SMTP_PASS=

# ---------- server ----------
# PORT: the host assigns one; 3000 locally.
PORT=3000
# NODE_ENV: Hostinger sets "production" itself. It switches the session cookie
# to Secure, trusts the reverse proxy, and moves the database to the home
# directory. Leave unset for local development.
NODE_ENV=
# Number of proxies in front of the app (production only).
TRUST_PROXY_HOPS=1

# ---------- e-mail (defaults match the live mailbox) ----------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nils@chogarkungfu.com
MAIL_FROM=Cho Gar Wing Chun <nils@chogarkungfu.com>
# Public address. Password-reset links are built from it — a wrong value makes
# every link useless. Defaults to https://chogarkungfu.com in production.
SITE_URL=https://chogarkungfu.com

# ---------- storage ----------
# Must point OUTSIDE the deployed folder: the host replaces that folder on every
# deployment. Defaults to ~/chogar-data in production, server/data otherwise.
CHOGAR_DATA_DIR=

# ---------- instructor account ----------
# CHOGAR_ADMIN_EMAIL is applied on every start — that is how the address is
# corrected. The other three are only used while the account is created.
CHOGAR_ADMIN_EMAIL=nils@chogarkungfu.com
CHOGAR_ADMIN_USER=instructor
CHOGAR_ADMIN_NAME=Sifu Nils Ring
CHOGAR_ADMIN_PASSWORD=

# Emergency password reset without a shell: set this, restart, sign in — then
# DELETE it again. While it is set, every restart resets the password anew.
CHOGAR_ADMIN_RESET_PASSWORD=
