# Copy to .env and fill in. Load it with: node --env-file=.env server.js
# .env is git-ignored — never commit real credentials.

# ---------- server ----------
PORT=3000
# Set on the live server. Makes the session cookie Secure (HTTPS only)
# and enables trusting the reverse proxy's X-Forwarded-For header.
NODE_ENV=production
# Number of proxies in front of the app. 1 is right for a single nginx/Caddy.
TRUST_PROXY_HOPS=1
# Public address of the site. Used to build links inside e-mails.
SITE_URL=https://your-domain.example

# ---------- first start only ----------
# Used once, when no instructor account exists yet.
CHOGAR_ADMIN_USER=instructor
CHOGAR_ADMIN_PASSWORD=
CHOGAR_ADMIN_NAME=Sifu Nils Ring
CHOGAR_ADMIN_EMAIL=sifu@kungfu-spirit.de

# ---------- e-mail ----------
# Without SMTP_HOST nothing is sent — messages are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cho Gar Wing Chun <no-reply@your-domain.example>

# ---------- storage ----------
# Where the SQLite database lives. Point this at a backed-up volume.
CHOGAR_DATA_DIR=./data
